{%- liquid
  assign blocks_count = section.blocks.size
  if section.settings.style == 'light'
    assign style_class = 'vitalis-benefits--light'
  else
    assign style_class = 'vitalis-benefits--dark'
  endif
-%}

<div
  class='vitalis-benefits {{ style_class }}'
  style='--vb-pt: {{ section.settings.padding_top }}; --vb-pb: {{ section.settings.padding_bottom }};'
>
  <xo-container {% render 'section-layout' %}>
    {%- if section.settings.subtitle != blank or section.settings.title != blank or section.settings.description != blank -%}
      <div class='vitalis-benefits__header'>
        {%- if section.settings.subtitle != blank -%}
          <p class='vitalis-benefits__subtitle'>{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class='vitalis-benefits__title'>{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class='vitalis-benefits__description'>{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if blocks_count > 0 -%}
      <vitalis-benefits class='vitalis-benefits__body'>
        <div class='vitalis-benefits__tabs' role='tablist' aria-label='{{ section.settings.title | default: 'Supplements' | escape }}'>
          {%- for block in section.blocks -%}
            <button
              type='button'
              role='tab'
              id='VitalisBenefitsTab-{{ block.id }}'
              class='vitalis-benefits__tab'
              aria-controls='VitalisBenefitsPanel-{{ block.id }}'
              aria-selected='{% if forloop.first %}true{% else %}false{% endif %}'
              {% unless forloop.first %}
                tabindex='-1'
              {% endunless %}
            >
              {{- block.settings.tab_label | default: block.settings.product.title | escape -}}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign heading = block.settings.heading | default: block.settings.tab_label | default: product.title
            assign media_image = block.settings.image | default: product.featured_media.preview_image
          -%}
          <div
            role='tabpanel'
            id='VitalisBenefitsPanel-{{ block.id }}'
            class='vitalis-benefits__panel'
            aria-labelledby='VitalisBenefitsTab-{{ block.id }}'
            {% unless forloop.first %}
              hidden
            {% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class='vitalis-benefits__media{% if block.settings.image != blank %} vitalis-benefits__media--cover{% endif %}'>
              {%- if media_image != blank -%}
                {{
                  media_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 42vw, (min-width: 768px) 45vw, 90vw',
                    loading: 'lazy',
                    alt: heading
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'vitalis-benefits__placeholder' }}
              {%- endif -%}
            </div>

            <div class='vitalis-benefits__content'>
              {%- if block.settings.label != blank -%}
                <p class='vitalis-benefits__label'>{{ block.settings.label | escape }}</p>
              {%- endif -%}
              <h3 class='vitalis-benefits__name'>{{ heading | escape }}</h3>
              {%- if block.settings.intro != blank -%}
                <p class='vitalis-benefits__intro'>{{ block.settings.intro | escape }}</p>
              {%- endif -%}

              {%- assign benefit_count = 0 -%}
              {%- capture benefits -%}
                {%- for i in (1..4) -%}
                  {%- assign key = 'benefit_' | append: i -%}
                  {%- assign title_key = key | append: '_title' -%}
                  {%- assign benefit = block.settings[key] -%}
                  {%- assign benefit_title = block.settings[title_key] -%}
                  {%- if benefit != blank or benefit_title != blank -%}
                    {%- assign benefit_count = benefit_count | plus: 1 -%}
                    <li class='vitalis-benefits__benefit'>
                      {%- if benefit_title != blank -%}
                        <span class='vitalis-benefits__benefit-title'>{{ benefit_title | escape }}</span>
                      {%- endif -%}
                      {%- if benefit != blank -%}
                        <span class='vitalis-benefits__benefit-text'>{{ benefit | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if benefits != blank -%}
                <ul class='vitalis-benefits__grid' role='list'>
                  {{ benefits }}
                  {%- assign remainder = benefit_count | modulo: 2 -%}
                  {%- if remainder == 1 -%}
                    <li class='vitalis-benefits__benefit vitalis-benefits__benefit--empty' aria-hidden='true'></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.best_for != blank or block.settings.usage != blank -%}
                <dl class='vitalis-benefits__meta'>
                  {%- if block.settings.best_for != blank -%}
                    <div>
                      <dt>{{ section.settings.best_for_label | escape }}</dt>
                      <dd>{{ block.settings.best_for | escape }}</dd>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.usage != blank -%}
                    <div>
                      <dt>{{ section.settings.usage_label | escape }}</dt>
                      <dd>{{ block.settings.usage | escape }}</dd>
                    </div>
                  {%- endif -%}
                </dl>
              {%- endif -%}

              {%- assign button_url = block.settings.button_link | default: product.url -%}
              {%- if button_url != blank -%}
                <div class='vitalis-benefits__actions'>
                  <a href='{{ button_url }}' class='vitalis-benefits__button'>
                    {{- block.settings.button_label | default: 'Shop now' | escape -}}
                  </a>
                  {%- if product != blank -%}
                    <span class='vitalis-benefits__price'>
                      {%- if product.price_varies -%}
                        {{- section.settings.from_label | escape }}&nbsp;
                      {%- endif -%}
                      {{- product.price_min | money -}}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </vitalis-benefits>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class='vitalis-benefits__footnote'>{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </xo-container>
</div>

{% stylesheet %}
  .vitalis-benefits {
    --vb-gold: #dcc28a;
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--vb-pt) * 0.6px);
    padding-bottom: calc(var(--vb-pb) * 0.6px);
    background-color: var(--vb-bg);
    color: rgb(var(--vb-fg));
  }

  .vitalis-benefits--dark {
    --vb-bg: #0d0d0f;
    --vb-fg: 255, 255, 255;
    --vb-accent: #dcc28a;
    --vb-accent-ink: #0d0d0f;
    --vb-media-bg: #ffffff;
    background-image: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(220, 194, 138, 0.1), transparent 70%);
  }

  .vitalis-benefits--light {
    --vb-bg: #f7f4ee;
    --vb-fg: 13, 13, 15;
    --vb-accent: #8f7a4e;
    --vb-accent-ink: #ffffff;
    --vb-media-bg: #ffffff;
  }

  @media (min-width: 768px) {
    .vitalis-benefits {
      padding-top: calc(var(--vb-pt) * 1px);
      padding-bottom: calc(var(--vb-pb) * 1px);
    }
  }

  .vitalis-benefits__header {
    max-width: 96rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .vitalis-benefits__subtitle {
    margin: 0 0 1.6rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--vb-accent);
  }

  .vitalis-benefits__title {
    margin: 0;
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(2.8rem, 2.4vw + 1.6rem, 4.8rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--vb-fg));
  }

  .vitalis-benefits__description {
    margin-top: 1.6rem;
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgba(var(--vb-fg), 0.7);
  }

  .vitalis-benefits__description p {
    margin: 0;
  }

  /* Tabs copy the theme's own tab pattern (product-v13__tab) so they match
     the other sections: stacked full-width buttons on mobile with the active
     one filled in the accent color; on desktop a centered row with a
     hairline and an accent underline on the active tab. */
  .vitalis-benefits__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 0 0 3rem;
  }

  .vitalis-benefits__tab {
    position: relative;
    width: 100%;
    padding: 1rem 0;
    border: 0;
    background-color: rgba(var(--vb-fg), 0.05);
    color: rgba(var(--vb-fg), 0.5);
    font-family: var(--font-custom-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.6rem, calc(0.25vw + 1.5rem), 1.8rem);
    line-height: calc(1 + 0.2 / var(--font-heading-scale));
    letter-spacing: calc(var(--font-heading-scale) * 0.16rem);
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.3s, background-color 0.3s;
  }

  .vitalis-benefits__tab[aria-selected='true'] {
    background-color: var(--vb-accent);
    color: var(--vb-accent-ink);
  }

  .vitalis-benefits__tab:focus-visible {
    outline: 0.1rem solid var(--vb-accent);
    outline-offset: 0.3rem;
  }

  @media (min-width: 768px) {
    .vitalis-benefits__tabs {
      flex-wrap: nowrap;
      gap: 5rem;
      margin: 0 0 6rem;
      border-bottom: 0.1rem solid rgba(var(--vb-fg), 0.1);
    }

    .vitalis-benefits__tab {
      width: fit-content;
      padding: 0 0 1.8rem;
      background: none;
      white-space: nowrap;
    }

    .vitalis-benefits__tab::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -0.2rem;
      width: 0;
      height: 0.3rem;
      background-color: var(--vb-accent);
      transform: translateX(-50%);
      transition: width 0.3s ease;
    }

    .vitalis-benefits__tab[aria-selected='true'] {
      background: none;
      color: rgb(var(--vb-fg));
    }

    .vitalis-benefits__tab:hover {
      color: rgb(var(--vb-fg));
    }

    .vitalis-benefits__tab:hover::after,
    .vitalis-benefits__tab[aria-selected='true']::after {
      width: 100%;
    }
  }

  .vitalis-benefits__panel {
    display: grid;
    gap: 3.2rem;
    align-items: center;
    animation: vitalis-benefits-in 0.5s ease both;
  }

  .vitalis-benefits__panel[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .vitalis-benefits__panel {
      grid-template-columns: 5fr 6fr;
      gap: clamp(4rem, 6vw, 9rem);
    }
  }

  @keyframes vitalis-benefits-in {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vitalis-benefits__panel {
      animation: none;
    }
  }

  .vitalis-benefits__media {
    position: relative;
    aspect-ratio: 1;
    max-width: 52rem;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    background-color: var(--vb-media-bg);
  }

  .vitalis-benefits__media img,
  .vitalis-benefits__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .vitalis-benefits__media--cover img {
    object-fit: cover;
  }

  .vitalis-benefits__placeholder {
    background-color: rgba(13, 13, 15, 0.06);
    fill: rgba(13, 13, 15, 0.3);
  }

  .vitalis-benefits__label {
    margin: 0 0 1.2rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--vb-accent);
  }

  .vitalis-benefits__name {
    margin: 0 0 1.6rem;
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(2.6rem, 1.6vw + 1.8rem, 3.8rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--vb-fg));
  }

  .vitalis-benefits__intro {
    margin: 0 0 2.8rem;
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--vb-fg), 0.75);
  }

  /* "Formula sheet": benefits as a grid of cells divided by a hairline
     cross, each with a keyword headline and the claim underneath. */
  .vitalis-benefits__grid {
    display: grid;
    margin: 0 0 3.6rem;
    padding: 0;
    list-style: none;
    border-top: 0.1rem solid rgba(var(--vb-fg), 0.14);
  }

  .vitalis-benefits__benefit {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 2rem 0;
    border-bottom: 0.1rem solid rgba(var(--vb-fg), 0.14);
  }

  @media (min-width: 576px) {
    .vitalis-benefits__grid {
      grid-template-columns: 1fr 1fr;
    }

    .vitalis-benefits__benefit {
      padding: 2.4rem 2.8rem 2.4rem 0;
    }

    .vitalis-benefits__benefit:nth-child(even) {
      padding: 2.4rem 0 2.4rem 2.8rem;
      border-left: 0.1rem solid rgba(var(--vb-fg), 0.14);
    }

  }

  /* Filler cell that completes the grid when there is an odd number of
     benefits; not needed in the single-column mobile layout. */
  @media (max-width: 575px) {
    .vitalis-benefits__benefit--empty {
      display: none;
    }
  }

  .vitalis-benefits__benefit-title {
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: 1.7rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vb-accent);
  }

  .vitalis-benefits__benefit-text {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--vb-fg), 0.72);
  }

  .vitalis-benefits__meta {
    display: grid;
    gap: 2rem;
    margin: 0 0 3.6rem;
  }

  @media (min-width: 576px) {
    .vitalis-benefits__meta {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .vitalis-benefits__meta dt {
    margin-bottom: 0.6rem;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vb-accent);
  }

  .vitalis-benefits__meta dd {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--vb-fg), 0.75);
  }

  .vitalis-benefits__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.6rem 2.4rem;
  }

  .vitalis-benefits__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 0 3.2rem;
    background-color: var(--vb-accent);
    color: var(--vb-accent-ink);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s;
  }

  .vitalis-benefits__button:hover {
    background-color: rgb(var(--vb-fg));
    color: var(--vb-bg);
  }

  .vitalis-benefits__price {
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    color: rgba(var(--vb-fg), 0.7);
  }

  .vitalis-benefits__footnote {
    max-width: 80rem;
    margin: 6rem auto 0;
    font-size: 1.2rem;
    line-height: 1.6;
    text-align: center;
    color: rgba(var(--vb-fg), 0.45);
  }
{% endstylesheet %}

