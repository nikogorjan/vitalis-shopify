{%- liquid
  assign image_desktop = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image_desktop
  assign form_id = 'VitalisNewsletter-' | append: section.id
-%}

<div class='vitalis-newsletter' style='--vn-pt: {{ section.settings.padding_top }}; --vn-pb: {{ section.settings.padding_bottom }};'>
  <xo-container {% render 'section-layout' %}>
    <div class='vitalis-newsletter__frame'>
      <div class='vitalis-newsletter__media'>
        {%- if image_desktop != blank -%}
          <picture>
            <source
              media='(min-width: 768px)'
              srcset='{%- for w in (6..16) -%}{%- assign width = w | times: 150 -%}{{ image_desktop | image_url: width: width }} {{ width }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}'
              sizes='100vw'
            >
            {{
              image_mobile
              | image_url: width: 1200
              | image_tag:
                widths: '400, 600, 800, 1000, 1200',
                sizes: '100vw',
                loading: 'lazy',
                alt: ''
            }}
          </picture>
        {%- endif -%}
      </div>

      <div class='vitalis-newsletter__content'>
        {%- if section.settings.subtitle != blank -%}
          <p class='vitalis-newsletter__subtitle'>{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class='vitalis-newsletter__title'>{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class='vitalis-newsletter__text'>{{ section.settings.text }}</div>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'vitalis-newsletter__form' -%}
          <input type='hidden' name='contact[tags]' value='newsletter'>
          {%- if form.posted_successfully? -%}
            <p class='vitalis-newsletter__message vitalis-newsletter__message--success' id='{{ form_id }}-success' tabindex='-1' autofocus>
              {{ 'newsletter.success' | t }}
            </p>
          {%- else -%}
            <div class='vitalis-newsletter__field'>
              <label class='xo-visually-hidden' for='{{ form_id }}-email'>{{ 'newsletter.email' | t }}</label>
              <input
                id='{{ form_id }}-email'
                class='vitalis-newsletter__input'
                type='email'
                name='contact[email]'
                value='{{ form.email }}'
                placeholder='{{ 'newsletter.email' | t }}'
                autocomplete='email'
                autocorrect='off'
                autocapitalize='off'
                required
                aria-required='true'
                {% if form.errors %}
                  aria-invalid='true' aria-describedby='{{ form_id }}-error'
                {% endif %}
              >
              <button type='submit' class='vitalis-newsletter__button'>
                {{- section.settings.button_label | default: 'Subscribe' | escape -}}
              </button>
            </div>
            {%- if form.errors -%}
              <p class='vitalis-newsletter__message vitalis-newsletter__message--error' id='{{ form_id }}-error'>
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.note != blank -%}
          <p class='vitalis-newsletter__note'>{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </xo-container>
</div>

{% stylesheet %}
  .vitalis-newsletter {
    padding-top: calc(var(--vn-pt) * 0.6px);
    padding-bottom: calc(var(--vn-pb) * 0.6px);
  }

  @media (min-width: 768px) {
    .vitalis-newsletter {
      padding-top: calc(var(--vn-pt) * 1px);
      padding-bottom: calc(var(--vn-pb) * 1px);
    }
  }

  .vitalis-newsletter__frame {
    position: relative;
    overflow: hidden;
    background-color: #0d0d0f;
    color: #fff;
  }

  /* Mobile: image on top, form in a dark panel below. */
  .vitalis-newsletter__media {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .vitalis-newsletter__media:empty {
    display: none;
  }

  .vitalis-newsletter__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vitalis-newsletter__content {
    position: relative;
    padding: 3.2rem 2.4rem 4rem;
  }

  /* Desktop: image fills the frame, content on the left over a dark fade. */
  @media (min-width: 768px) {
    .vitalis-newsletter__frame {
      min-height: clamp(40rem, 34vw, 50rem);
      display: flex;
      align-items: center;
    }

    .vitalis-newsletter__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .vitalis-newsletter__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(13, 13, 15, 0.94) 0%, rgba(13, 13, 15, 0.75) 40%, rgba(13, 13, 15, 0) 70%);
    }

    .vitalis-newsletter__content {
      width: 100%;
      max-width: 60rem;
      padding: 6rem clamp(3.2rem, 5vw, 8rem);
    }
  }

  .vitalis-newsletter__subtitle {
    margin: 0 0 2rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #dcc28a;
  }

  .vitalis-newsletter__title {
    margin: 0 0 1.6rem;
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(2.8rem, 2.4vw + 1.6rem, 4.8rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .vitalis-newsletter__text {
    margin-bottom: 3.2rem;
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  .vitalis-newsletter__text p {
    margin: 0;
  }

  /* Email field and button on one line; stacked on very small screens. */
  .vitalis-newsletter__field {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (min-width: 420px) {
    .vitalis-newsletter__field {
      flex-wrap: nowrap;
      gap: 0;
    }
  }

  .vitalis-newsletter__input {
    flex: 1 1 22rem;
    min-width: 0;
    height: 5.2rem;
    padding: 0 1.8rem;
    border: 0.1rem solid rgba(255, 255, 255, 0.3);
    border-radius: 0;
    background-color: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 1.5rem;
  }

  .vitalis-newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .vitalis-newsletter__input:focus {
    outline: none;
    border-color: #dcc28a;
  }

  .vitalis-newsletter__button {
    flex: 0 0 auto;
    height: 5.2rem;
    padding: 0 3.2rem;
    border: 0;
    border-radius: 0;
    background-color: #dcc28a;
    color: #0d0d0f;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  @media (max-width: 419px) {
    .vitalis-newsletter__button {
      flex-basis: 100%;
    }
  }

  .vitalis-newsletter__button:hover {
    background-color: #fff;
  }

  .vitalis-newsletter__button:focus-visible {
    outline: 0.2rem solid #fff;
    outline-offset: 0.2rem;
  }

  .vitalis-newsletter__message {
    margin: 1.2rem 0 0;
    font-size: 1.4rem;
  }

  .vitalis-newsletter__message--success {
    margin: 0;
    padding: 1.6rem 1.8rem;
    border: 0.1rem solid #dcc28a;
    color: #dcc28a;
  }

  .vitalis-newsletter__message--error {
    color: #f3a6a6;
  }

  .vitalis-newsletter__note {
    margin: 1.6rem 0 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.5);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Text sits on the left, so pick a photo with the subject on the right."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown above the form on phones (16:9)."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Join the Vitalis circle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New products, training tips and member-only offers, straight to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "No spam. Unsubscribe anytime."
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "box",
      "options": [
        { "value": "box", "label": "t:sections.all.width.options__1.label" },
        { "value": "wide", "label": "t:sections.all.width.options__2.label" },
        { "value": "fullwidth", "label": "t:sections.all.width.options__3.label" }
      ]
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "t:sections.all.fullwidth_margin.label",
      "default": 0,
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Newsletter banner"
    }
  ]
}
{% endschema %}
