<div class='vitalis-announcement'>
  <div class='vitalis-announcement__inner'>
    <div class='vitalis-announcement__spacer' aria-hidden='true'></div>

    <p class='vitalis-announcement__text'>
      {%- if section.settings.link != blank -%}
        <a href='{{ section.settings.link }}'>{{ section.settings.text | escape }}</a>
      {%- else -%}
        {{ section.settings.text | escape }}
      {%- endif -%}
    </p>

    <ul class='vitalis-announcement__social' role='list'>
      {%- assign networks = 'instagram,facebook,x' | split: ',' -%}
      {%- assign labels = 'Instagram,Facebook,X' | split: ',' -%}
      {%- for key in networks -%}
        {%- assign label = labels[forloop.index0] -%}
        {%- assign setting = key | append: '_link' -%}
        {%- assign url = section.settings[setting] -%}
        {%- if url != blank -%}
          <li>
            <a href='{{ url }}' target='_blank' rel='noopener' aria-label='{{ label }}'>
              {%- render 'vitalis-social-icon', name: key -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .vitalis-announcement {
    position: relative;
    z-index: 101;
    background-color: #dcc28a;
    color: #0d0d0f;
  }

  /* Text centered on the page, social icons on the right. */
  .vitalis-announcement__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.6rem;
    min-height: 4rem;
    padding: 0.8rem 2rem;
  }

  .vitalis-announcement__text {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
  }

  .vitalis-announcement__text a {
    color: inherit;
    text-decoration: none;
  }

  .vitalis-announcement__social {
    display: flex;
    justify-content: flex-end;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vitalis-announcement__social a {
    display: flex;
    color: inherit;
    font-size: 1.6rem;
    transition: opacity 0.3s;
  }

  .vitalis-announcement__social a:hover {
    opacity: 0.6;
  }

  /* Phones: only the message, centered (the icons are in the footer). */
  @media (max-width: 749px) {
    .vitalis-announcement__inner {
      grid-template-columns: 1fr;
    }

    .vitalis-announcement__spacer,
    .vitalis-announcement__social {
      display: none;
    }

    .vitalis-announcement__text {
      font-size: 1.1rem;
      letter-spacing: 0.15em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on orders over $100"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional."
    },
    {
      "type": "header",
      "content": "Social icons"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "x_link",
      "label": "X"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
