{%- liquid
  if section.settings.style == 'dark'
    assign style_class = 'vitalis-bento--dark'
  else
    assign style_class = 'vitalis-bento--light'
  endif
-%}

<div
  class='vitalis-bento {{ style_class }}'
  style='--vbt-pt: {{ section.settings.padding_top }}; --vbt-pb: {{ section.settings.padding_bottom }};'
>
  <xo-container {% render 'section-layout' %}>
    {%- if section.settings.subtitle != blank or section.settings.title != blank -%}
      <div class='vitalis-bento__header'>
        {%- if section.settings.subtitle != blank -%}
          <p class='vitalis-bento__eyebrow'>{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class='vitalis-bento__heading'>{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class='vitalis-bento__grid vitalis-bento__grid--{{ section.blocks.size }}' role='list'>
      {%- for block in section.blocks -%}
        {%- liquid
          assign tall = false
          if forloop.index == 1 or forloop.index == 3
            assign tall = true
          endif
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <li class='vitalis-bento__item{% if tall %} vitalis-bento__item--tall{% endif %}' {{ block.shopify_attributes }}>
          <{{ tag }}
            class='vitalis-bento__card'
            {% if tag == 'a' %}
              href='{{ block.settings.link }}'
            {% endif %}
          >
            <div class='vitalis-bento__media'>
              {%- if block.settings.image != blank -%}
                {%- assign image_mobile = block.settings.image_mobile | default: block.settings.image -%}
                <picture>
                  <source
                    media='(min-width: 768px)'
                    srcset='{%- for w in (6..16) -%}{%- assign width = w | times: 150 -%}{{ block.settings.image | image_url: width: width }} {{ width }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}'
                    sizes='50vw'
                  >
                  {{
                    image_mobile
                    | image_url: width: 1200
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '100vw',
                      loading: 'lazy',
                      alt: block.settings.image.alt
                      | default: block.settings.title
                      | escape
                  }}
                </picture>
              {%- else -%}
                {%- assign placeholder_index = forloop.index | modulo: 2 | plus: 1 -%}
                {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'vitalis-bento__placeholder' }}
              {%- endif -%}
            </div>

            <div class='vitalis-bento__content'>
              {%- if block.settings.subtitle != blank -%}
                <p class='vitalis-bento__subtitle'>{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class='vitalis-bento__title'>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <span class='vitalis-bento__link'>{{ block.settings.link_label | escape }}</span>
              {%- endif -%}
            </div>
          </{{ tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </xo-container>
</div>

{% stylesheet %}
  .vitalis-bento {
    padding-top: calc(var(--vbt-pt) * 0.6px);
    padding-bottom: calc(var(--vbt-pb) * 0.6px);
    background-color: var(--vbt-bg);
    color: rgb(var(--vbt-fg));
  }

  .vitalis-bento--light {
    --vbt-bg: #ffffff;
    --vbt-fg: 13, 13, 15;
    --vbt-accent: #8f7a4e;
  }

  .vitalis-bento--dark {
    --vbt-bg: #0d0d0f;
    --vbt-fg: 255, 255, 255;
    --vbt-accent: #dcc28a;
  }

  @media (min-width: 768px) {
    .vitalis-bento {
      padding-top: calc(var(--vbt-pt) * 1px);
      padding-bottom: calc(var(--vbt-pb) * 1px);
    }
  }

  .vitalis-bento__header {
    margin: 0 auto 4rem;
    text-align: center;
  }

  .vitalis-bento__eyebrow {
    margin: 0 0 1.6rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--vbt-accent);
  }

  .vitalis-bento__heading {
    margin: 0;
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(2.8rem, 2.4vw + 1.6rem, 4.8rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Mobile: one column, tall and short blocks alternate. */
  .vitalis-bento__grid {
    display: grid;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vitalis-bento__item {
    aspect-ratio: 4 / 3;
  }

  .vitalis-bento__item--tall {
    aspect-ratio: 4 / 5;
  }

  /* Desktop: two columns, staggered. Left: tall then short. Right: short
     then tall. Both columns end at the same height. */
  @media (min-width: 768px) {
    .vitalis-bento__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: clamp(22rem, 22vw, 34rem);
      gap: 2rem;
    }

    .vitalis-bento__item,
    .vitalis-bento__item--tall {
      aspect-ratio: auto;
    }

    .vitalis-bento__grid--4 .vitalis-bento__item:nth-child(1) {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .vitalis-bento__grid--4 .vitalis-bento__item:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }

    .vitalis-bento__grid--4 .vitalis-bento__item:nth-child(3) {
      grid-column: 2;
      grid-row: 2 / span 2;
    }

    .vitalis-bento__grid--4 .vitalis-bento__item:nth-child(4) {
      grid-column: 1;
      grid-row: 3;
    }
  }

  .vitalis-bento__card {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background-color: #0d0d0f;
  }

  .vitalis-bento__media,
  .vitalis-bento__media picture {
    position: absolute;
    inset: 0;
  }

  .vitalis-bento__media img,
  .vitalis-bento__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .vitalis-bento__placeholder {
    background-color: #1b1b1f;
    fill: rgba(255, 255, 255, 0.15);
  }

  a.vitalis-bento__card:hover .vitalis-bento__media img {
    transform: scale(1.04);
  }

  /* Fade behind the text so it stays readable on bright photos too. */
  .vitalis-bento__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 13, 15, 0.85) 0%,
      rgba(13, 13, 15, 0.5) 35%,
      rgba(13, 13, 15, 0.1) 65%,
      rgba(13, 13, 15, 0) 80%
    );
    pointer-events: none;
  }

  /* Short tiles: the text covers most of the height, so also fade from the
     left behind it. */
  .vitalis-bento__item:not(.vitalis-bento__item--tall) .vitalis-bento__media::after {
    background:
      linear-gradient(to right, rgba(13, 13, 15, 0.6) 0%, rgba(13, 13, 15, 0.25) 45%, rgba(13, 13, 15, 0) 70%),
      linear-gradient(to top, rgba(13, 13, 15, 0.85) 0%, rgba(13, 13, 15, 0.45) 50%, rgba(13, 13, 15, 0.1) 85%);
  }

  .vitalis-bento__subtitle,
  .vitalis-bento__title,
  .vitalis-bento__link {
    text-shadow: 0 0.1rem 0.2rem rgba(0, 0, 0, 0.5), 0 0.2rem 1.6rem rgba(0, 0, 0, 0.45);
  }

  .vitalis-bento__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.4rem;
  }

  @media (min-width: 990px) {
    .vitalis-bento__content {
      padding: 3.6rem;
    }
  }

  .vitalis-bento__subtitle {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #dcc28a;
  }

  .vitalis-bento__title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(2.2rem, 1.4vw + 1.6rem, 3.4rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .vitalis-bento__link {
    position: relative;
    display: inline-block;
    margin-top: 1.8rem;
    padding-bottom: 0.6rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
  }

  .vitalis-bento__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 0.2rem;
    background-color: #dcc28a;
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  a.vitalis-bento__card:hover .vitalis-bento__link::after {
    transform: scaleX(0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .vitalis-bento__media img,
    .vitalis-bento__link::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bento grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Designed for 4 blocks: tall and short tiles staggered over two columns."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "light",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "box",
      "options": [
        { "value": "box", "label": "t:sections.all.width.options__1.label" },
        { "value": "wide", "label": "t:sections.all.width.options__2.label" },
        { "value": "fullwidth", "label": "t:sections.all.width.options__3.label" }
      ]
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "t:sections.all.fullwidth_margin.label",
      "default": 0,
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 100
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "Tiles 1 and 3 are tall (portrait photos work best), tiles 2 and 4 are short (landscape)."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional. Defaults to the image above."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento grid",
      "blocks": [
        { "type": "tile", "settings": { "subtitle": "Apparel", "title": "Wear the standard", "link_label": "Shop merch" } },
        { "type": "tile", "settings": { "subtitle": "Pre-workout", "title": "Your pre-training ritual", "link_label": "Shop energy & focus" } },
        { "type": "tile", "settings": { "subtitle": "Protein", "title": "After every session", "link_label": "Shop protein" } },
        { "type": "tile", "settings": { "subtitle": "Daily essentials", "title": "Start your day right", "link_label": "Shop wellness" } }
      ]
    }
  ]
}
{% endschema %}
