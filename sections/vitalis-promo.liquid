{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant

  if section.settings.variant_id != blank and product != blank
    assign wanted_id = section.settings.variant_id | strip | plus: 0
    for v in product.variants
      if v.id == wanted_id
        assign variant = v
        break
      endif
    endfor
  endif

  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
    assign saving = variant.compare_at_price | minus: variant.price
    assign percent = saving | times: 100.0 | divided_by: variant.compare_at_price | round
  endif

  if section.settings.badge != blank
    assign badge = section.settings.badge
  elsif on_sale
    assign badge = '−' | append: percent | append: '%'
  endif

  assign button_url = section.settings.button_link
  if button_url == blank and product != blank
    assign button_url = variant.url | default: product.url
  endif

  assign title = section.settings.title | default: product.title
  assign image_desktop = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image_desktop
-%}

<div class='vitalis-promo' style='--vp-pt: {{ section.settings.padding_top }}; --vp-pb: {{ section.settings.padding_bottom }};'>
  <xo-container {% render 'section-layout' %}>
    <div class='vitalis-promo__frame'>
      <div class='vitalis-promo__media'>
        {%- if image_desktop != blank -%}
          <picture>
            <source
              media='(min-width: 768px)'
              srcset='{%- for w in (6..16) -%}{%- assign width = w | times: 150 -%}{{ image_desktop | image_url: width: width }} {{ width }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}'
              sizes='100vw'
            >
            {{
              image_mobile
              | image_url: width: 1200
              | image_tag:
                widths: '400, 600, 800, 1000, 1200',
                sizes: '100vw',
                loading: 'lazy',
                alt: title
                | escape
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'vitalis-promo__placeholder' }}
        {%- endif -%}
      </div>

      {%- if badge != blank -%}
        <div class='vitalis-promo__badge'>
          <span class='vitalis-promo__badge-value'>{{ badge | escape }}</span>
          {%- if section.settings.badge_label != blank -%}
            <span class='vitalis-promo__badge-label'>{{ section.settings.badge_label | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class='vitalis-promo__content'>
        {%- if section.settings.subtitle != blank -%}
          <p class='vitalis-promo__subtitle'>{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        {%- if title != blank -%}
          <h2 class='vitalis-promo__title'>{{ title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class='vitalis-promo__description'>{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if product != blank and section.settings.show_price -%}
          <div class='vitalis-promo__price'>
            <span class='vitalis-promo__price-now'>{{ variant.price | money }}</span>
            {%- if on_sale -%}
              <s class='vitalis-promo__price-was'>{{ variant.compare_at_price | money }}</s>
              <span class='vitalis-promo__price-save'>
                {{- section.settings.save_label | escape }}
                {{ saving | money -}}
              </span>
            {%- endif -%}
          </div>
          {%- if on_sale and section.settings.price_note != blank -%}
            <p class='vitalis-promo__note'>{{ section.settings.price_note | escape }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.button_label != blank and button_url != blank -%}
          <a href='{{ button_url }}' class='vitalis-promo__button'>{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </xo-container>
</div>

{% stylesheet %}
  .vitalis-promo {
    padding-top: calc(var(--vp-pt) * 0.6px);
    padding-bottom: calc(var(--vp-pb) * 0.6px);
  }

  @media (min-width: 768px) {
    .vitalis-promo {
      padding-top: calc(var(--vp-pt) * 1px);
      padding-bottom: calc(var(--vp-pb) * 1px);
    }
  }

  .vitalis-promo__frame {
    position: relative;
    overflow: hidden;
    background-color: #0d0d0f;
    color: #fff;
  }

  /* Mobile: image on top, text in a dark panel below. */
  .vitalis-promo__media {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .vitalis-promo__media img,
  .vitalis-promo__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vitalis-promo__placeholder {
    background-color: #1b1b1f;
    fill: rgba(255, 255, 255, 0.15);
  }

  .vitalis-promo__content {
    position: relative;
    padding: 3.2rem 2.4rem 4rem;
  }

  /* Desktop: image fills the frame, text on the left over a dark fade. */
  @media (min-width: 768px) {
    .vitalis-promo__frame {
      min-height: clamp(44rem, 38vw, 56rem);
      display: flex;
      align-items: center;
    }

    .vitalis-promo__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .vitalis-promo__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(13, 13, 15, 0.92) 0%, rgba(13, 13, 15, 0.7) 35%, rgba(13, 13, 15, 0) 65%);
    }

    .vitalis-promo__content {
      max-width: 56rem;
      padding: 6rem clamp(3.2rem, 5vw, 8rem);
    }
  }

  /* Corner ribbon: a gold band rotated across the top-right corner. The
     frame's overflow: hidden cuts the ends off at both edges, so it reads as
     wrapped around the corner. */
  .vitalis-promo__badge {
    position: absolute;
    top: 3.4rem;
    right: -6.6rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 26rem;
    padding: 0.9rem 0;
    background-color: #dcc28a;
    color: #0d0d0f;
    transform: rotate(45deg);
    box-shadow: 0 0.4rem 1.2rem rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .vitalis-promo__badge {
      top: 4.6rem;
      right: -8.4rem;
      width: 34rem;
      padding: 1.2rem 0;
      gap: 1.2rem;
    }
  }

  .vitalis-promo__badge-value {
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(1.8rem, 0.6vw + 1.6rem, 2.4rem);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .vitalis-promo__badge-label {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .vitalis-promo__subtitle {
    margin: 0 0 2rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #dcc28a;
  }

  .vitalis-promo__title {
    margin: 0 0 1.6rem;
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(2.8rem, 2.4vw + 1.6rem, 4.8rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .vitalis-promo__description {
    margin-bottom: 2.8rem;
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
  }

  .vitalis-promo__description p {
    margin: 0;
  }

  .vitalis-promo__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.6rem;
    margin-bottom: 1rem;
  }

  .vitalis-promo__price-now {
    font-family: var(--font-custom-family);
    font-weight: var(--font-custom-weight, 700);
    font-size: clamp(3.2rem, 2vw + 2.4rem, 4.4rem);
    line-height: 1;
    color: #fff;
  }

  .vitalis-promo__price-was {
    font-size: 1.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .vitalis-promo__price-save {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #dcc28a;
  }

  .vitalis-promo__note {
    margin: 0 0 3.2rem;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.5);
  }

  .vitalis-promo__price + .vitalis-promo__button {
    margin-top: 2.2rem;
  }

  .vitalis-promo__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 0 3.2rem;
    background-color: #dcc28a;
    color: #0d0d0f;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s;
  }

  .vitalis-promo__button:hover {
    background-color: #fff;
    color: #0d0d0f;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Supplies the price, the old (compare-at) price, the discount % and the link."
    },
    {
      "type": "text",
      "id": "variant_id",
      "label": "Variant ID",
      "info": "Optional. Show a specific variant (e.g. Women / 60 capsules). Find the ID in the admin: open the variant, the number at the end of the URL."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown above the text on phones (4:3)."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Corner badge",
      "info": "Shown in the top-right corner. Leave empty to show the discount automatically (e.g. −20%) when the product has a compare-at price."
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Corner badge label",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Limited offer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Defaults to the product title."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "\"You save\" label",
      "default": "You save"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "Old price is the lowest price of the last 30 days.",
      "info": "Shown under the price when the product is on sale. EU rules require the old price to be the lowest price of the previous 30 days."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Optional. Defaults to the product (and variant)."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.all.width.label",
      "default": "box",
      "options": [
        {
          "value": "box",
          "label": "t:sections.all.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.all.width.options__2.label"
        },
        {
          "value": "fullwidth",
          "label": "t:sections.all.width.options__3.label"
        }
      ]
    },
    {
      "type": "number",
      "id": "fullwidth_margin",
      "label": "t:sections.all.fullwidth_margin.label",
      "default": 0,
      "visible_if": "{{ section.settings.width == 'fullwidth' }}"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Promo banner"
    }
  ]
}
{% endschema %}
